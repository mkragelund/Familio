rules_version = '2';

// Sikkerhedsregler for Familios EGEN database ("familio").
// De påvirker IKKE (default)-databasen eller de andre apps i projektet.
//
// Forældre: logget ind med Google og står i familiens "parents"-liste (uid).
// Tablet:   anonymt login, og dens uid er godkendt i familiens "tablets"-liste.
//           Tabletten må læse familiens data og krydse pligter og huskelister af – intet andet.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAnon() { return request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function isPerson() { return signedIn() && !isAnon(); }
    function famPath(fid) { return /databases/$(database)/documents/families/$(fid); }
    function fam(fid) { return get(famPath(fid)).data; }
    function isParent(fid) { return isPerson() && exists(famPath(fid)) && request.auth.uid in fam(fid).parents; }
    function isTablet(fid) { return signedIn() && exists(famPath(fid)) && request.auth.uid in fam(fid).tablets; }
    function isMember(fid) { return isParent(fid) || isTablet(fid); }

    // Hvilken familie hører jeg til
    match /users/{uid} {
      allow read, write: if isPerson() && request.auth.uid == uid;
    }

    // Invitationskoder (kun opslag på den præcise kode – ingen liste)
    match /invites/{code} {
      allow get: if isPerson();
      allow list: if false;
      allow create: if isPerson() && isParent(request.resource.data.familyId)
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isPerson() && isParent(resource.data.familyId);
    }

    // En ny tablet viser en kode; en forælder slår koden op og godkender
    match /pairing/{code} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow get: if signedIn();
      allow list: if false;
      allow delete: if signedIn() && (resource.data.uid == request.auth.uid || isPerson());
    }

    // Hvilken familie en godkendt tablet hører til
    match /tabletLinks/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow create, update: if isParent(request.resource.data.familyId);
      allow delete: if isParent(resource.data.familyId);
    }

    match /families/{fid} {
      allow read: if isMember(fid);
      // Ny familie: opretteren er eneste forælder
      allow create: if isPerson()
        && request.resource.data.parents == [request.auth.uid]
        && request.resource.data.tablets == [];
      // Forældre må ændre alt. En ny forælder må KUN tilføje sig selv med en gyldig invitationskode.
      allow update: if isParent(fid) || joinWithInvite(fid);
      allow delete: if false;

      function joinWithInvite(fid) {
        let code = request.resource.data.joinCode;
        let inv = get(/databases/$(database)/documents/invites/$(code)).data;
        return isPerson()
          && !(request.auth.uid in resource.data.parents)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parents', 'parentNames', 'members', 'drivers', 'joinCode'])
          && request.resource.data.parents == resource.data.parents.concat([request.auth.uid])
          && inv.familyId == fid
          && inv.expiresAt > request.time.toMillis();
      }

      // Pligter krydset af (tablet og forældre)
      match /completions/{id} {
        allow read: if isMember(fid);
        allow create: if isMember(fid)
          && request.resource.data.pts is int
          && request.resource.data.pts >= 0 && request.resource.data.pts <= 100;
        allow delete: if isMember(fid);
        allow update: if isParent(fid);
      }

      // Huskelister krydset af (tablet og forældre)
      match /packed/{id} {
        allow read, create, delete: if isMember(fid);
      }

      // Alt andet: events, meals, adjustments – kun forældre skriver
      match /{coll}/{id} {
        allow read: if isMember(fid);
        allow write: if isParent(fid);
      }
    }
  }
}
